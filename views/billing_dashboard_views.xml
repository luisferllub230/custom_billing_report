<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Client action that mounts the OWL ``BillingDashboard``
        component. Registered under the tag
        ``custom_billing_report.dashboard`` (see
        static/src/js/billing_dashboard.js).
    -->
    <record id="action_billing_dashboard" model="ir.actions.client">
        <field name="name">Billing Dashboard</field>
        <field name="tag">custom_billing_report.dashboard</field>
        <field name="target">current</field>
    </record>

</odoo>
