<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_billing_report_landscape" model="report.paperformat">
        <field name="name">Billing Report Landscape A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_billing" model="ir.actions.report">
        <field name="name">Billing Report</field>
        <field name="model">billing.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_billing_report.report_billing_template</field>
        <field name="report_file">custom_billing_report.report_billing_template</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_billing_report_landscape"/>
        <field name="print_report_name">"Billing Report - %s" % (object.date_from or "")</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
