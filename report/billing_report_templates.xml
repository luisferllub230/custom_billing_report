<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_billing_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="company" t-value="res_company or env.company"/>
                <t t-set="currency" t-value="company.currency_id"/>
                <t t-set="opts" t-value="data['options']"/>
                <t t-set="totals" t-value="data['totals']"/>
                <t t-set="status_breakdown" t-value="data.get('breakdown_status') or {}"/>
                <t t-set="doc_type_breakdown" t-value="data.get('breakdown_doc_type') or []"/>
                <t t-set="salespersons" t-value="data.get('top_salespersons') or []"/>
                <t t-set="creators" t-value="data.get('top_creators') or []"/>
                <t t-set="payment_categories" t-value="data.get('payment_categories') or []"/>
                <t t-set="payment_total_collected" t-value="data.get('payment_total_collected') or 0.0"/>

                <div class="page">
                    <div class="oe_structure"/>

                    <h2 class="mt-3 mb-3">Billing Report</h2>

                    <!-- Filter summary -->
                    <div id="informations" class="row mt-2 mb-3">
                        <div class="col-6">
                            <strong>Period:</strong>
                            <span t-esc="opts.get('date_from') or ''"/>
                            <t t-if="opts.get('date_from') or opts.get('date_to')">
                                &#8594;
                            </t>
                            <span t-esc="opts.get('date_to') or ''"/>
                            <br/>
                            <strong>Status:</strong>
                            <t t-if="opts.get('payment_state') == 'paid'">Paid</t>
                            <t t-elif="opts.get('payment_state') == 'unpaid'">Pending Payment</t>
                            <t t-else="">All</t>
                        </div>
                        <div class="col-6">
                            <t t-if="opts.get('partner_ids')">
                                <strong>Customers:</strong>
                                <span t-esc="', '.join(env['res.partner'].browse(opts['partner_ids']).mapped('display_name'))"/>
                                <br/>
                            </t>
                            <t t-if="opts.get('payment_method_ids')">
                                <strong>Payment Methods:</strong>
                                <span t-esc="', '.join(env['account.payment.method.line'].browse(opts['payment_method_ids']).mapped('name'))"/>
                                <br/>
                            </t>
                            <t t-if="opts.get('l10n_latam_document_type_ids')">
                                <strong>NCF Types:</strong>
                                <span t-esc="', '.join(env['l10n_latam.document.type'].browse(opts['l10n_latam_document_type_ids']).mapped('display_name'))"/>
                                <br/>
                            </t>
                            <t t-if="opts.get('invoice_user_ids')">
                                <strong>Salespersons:</strong>
                                <span t-esc="', '.join(env['res.users'].browse(opts['invoice_user_ids']).mapped('display_name'))"/>
                                <br/>
                            </t>
                            <t t-if="opts.get('create_user_ids')">
                                <strong>Created By:</strong>
                                <span t-esc="', '.join(env['res.users'].browse(opts['create_user_ids']).mapped('display_name'))"/>
                            </t>
                        </div>
                    </div>

                    <!-- Summary KPIs (full width, clearly separated) -->
                    <h3 class="mt-4 mb-2">Summary</h3>
                    <table class="table table-sm o_main_table mb-4">
                        <thead>
                            <tr>
                                <th>Invoices</th>
                                <th class="text-end">Total Invoiced</th>
                                <th class="text-end">Total Paid</th>
                                <th class="text-end">Total Pending</th>
                                <th class="text-end">Total Tax</th>
                                <th class="text-end">Total Discount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <span t-esc="totals['count']"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['total_invoiced']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['total_paid']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['total_pending']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['total_tax']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['total_discount']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Breakdowns -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <h3 class="mb-2">By Status</h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th class="text-end">Invoices</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Paid</td>
                                        <td class="text-end">
                                            <span t-esc="status_breakdown.get('paid', {}).get('count', 0)"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="status_breakdown.get('paid', {}).get('amount_total', 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Pending Payment</td>
                                        <td class="text-end">
                                            <span t-esc="status_breakdown.get('pending', {}).get('count', 0)"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="status_breakdown.get('pending', {}).get('amount_total', 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-6" t-if="doc_type_breakdown">
                            <h3 class="mb-2">By Document Type</h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th class="text-end">Invoices</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc_type_breakdown" t-as="row">
                                        <td><span t-esc="row['name']"/></td>
                                        <td class="text-end"><span t-esc="row['count']"/></td>
                                        <td class="text-end">
                                            <span t-esc="row['amount_total']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Payment categories breakdown — daily cash-up -->
                    <div class="row mb-4" t-if="payment_categories">
                        <div class="col-12">
                            <h3 class="mb-2">By Payment Type</h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Payment Type</th>
                                        <th class="text-end">Amount Collected</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="payment_categories" t-as="cat">
                                        <td><span t-esc="cat['label']"/></td>
                                        <td class="text-end">
                                            <span t-esc="cat['amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="text-end"><strong>Total Collected</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="payment_total_collected"
                                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Created By breakdown -->
                    <div class="row mb-4" t-if="creators">
                        <div class="col-12">
                            <h3 class="mb-2">By Created By</h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Created By</th>
                                        <th class="text-end">Invoices</th>
                                        <th class="text-end">Total Invoiced</th>
                                        <th class="text-end">Paid</th>
                                        <th class="text-end">Pending</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="creators" t-as="cr">
                                        <td><span t-esc="cr['user_name']"/></td>
                                        <td class="text-end"><span t-esc="cr['count']"/></td>
                                        <td class="text-end">
                                            <span t-esc="cr['amount_total']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="cr['amount_paid']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="cr['amount_pending']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Salespersons breakdown -->
                    <div class="row mb-4" t-if="salespersons">
                        <div class="col-12">
                            <h3 class="mb-2">By Salesperson</h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Salesperson</th>
                                        <th class="text-end">Invoices</th>
                                        <th class="text-end">Total Invoiced</th>
                                        <th class="text-end">Paid</th>
                                        <th class="text-end">Pending</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="salespersons" t-as="sp">
                                        <td><span t-esc="sp['user_name']"/></td>
                                        <td class="text-end"><span t-esc="sp['count']"/></td>
                                        <td class="text-end">
                                            <span t-esc="sp['amount_total']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="sp['amount_paid']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="sp['amount_pending']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Detail table -->
                    <h3 class="mt-4 mb-2">Invoices</h3>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Salesperson</th>
                                <th>Created By</th>
                                <th>NCF</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Tax (ITBIS)</th>
                                <th class="text-end">Total</th>
                                <th>Payment Method</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['lines']" t-as="line">
                                <td><span t-esc="line['invoice_date']"/></td>
                                <td><span t-esc="line['name']"/></td>
                                <td><span t-esc="line['partner_name']"/></td>
                                <td><span t-esc="line['invoice_user_name']"/></td>
                                <td><span t-esc="line['create_user_name']"/></td>
                                <td><span t-esc="line['ncf']"/></td>
                                <td class="text-end">
                                    <span t-esc="line['amount_untaxed']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['discount']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['amount_tax']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['amount_total']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td><span t-esc="line['payment_method']"/></td>
                                <td><span t-esc="line['status_label']"/></td>
                            </tr>
                            <tr t-if="not data['lines']">
                                <td colspan="12" class="text-center text-muted">
                                    No invoices match the selected filters.
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-end">
                                    <strong>Totals</strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="totals['total_untaxed']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="totals['total_discount']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="totals['total_tax']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-esc="totals['total_invoiced']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </strong>
                                </td>
                                <td colspan="2"/>
                            </tr>
                        </tfoot>
                    </table>

                    <p class="text-muted small mt-3 mb-0">
                        Generated on <span t-esc="data['generated_at']"/>
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
