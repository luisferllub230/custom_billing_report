<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Main QWeb template for the Billing PDF report.

        Receives the rendering context built by
        report.custom_billing_report.report_billing_template
        ._get_report_values:

            data         => billing.report.get_report_data(options)
            doc_ids      => wizard ids
            docs         => wizard recordset

        We resolve ``company`` and ``currency`` once at the top so the
        rest of the template stays readable.
    -->
    <template id="report_billing_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="company" t-value="res_company or env.company"/>
                <t t-set="currency" t-value="company.currency_id"/>
                <div class="page">

                    <h2 class="mt16 mb16">Billing Report</h2>

                    <!-- Filter summary -->
                    <div class="row mb16">
                        <div class="col-6">
                            <strong>Period:</strong>
                            <span t-esc="data['options']['date_from']"/>
                            &#8594;
                            <span t-esc="data['options']['date_to']"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>Status:</strong>
                            <t t-if="data['options']['payment_state'] == 'all'">All</t>
                            <t t-elif="data['options']['payment_state'] == 'paid'">Paid</t>
                            <t t-elif="data['options']['payment_state'] == 'unpaid'">Pending Payment</t>
                        </div>
                    </div>

                    <!-- KPI strip -->
                    <table class="table table-sm mb16" style="background-color:#f7f7f7;">
                        <tr>
                            <td><strong>Invoices</strong><br/>
                                <span t-esc="data['totals']['count']"/>
                            </td>
                            <td><strong>Total Invoiced</strong><br/>
                                <span t-esc="data['totals']['total_invoiced']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td><strong>Total Paid</strong><br/>
                                <span t-esc="data['totals']['total_paid']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td><strong>Total Pending</strong><br/>
                                <span t-esc="data['totals']['total_pending']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td><strong>Total Tax</strong><br/>
                                <span t-esc="data['totals']['total_tax']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td><strong>Total Discount</strong><br/>
                                <span t-esc="data['totals']['total_discount']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Detail table -->
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>NCF</th>
                                <th class="text-right">Subtotal</th>
                                <th class="text-right">Discount</th>
                                <th class="text-right">Tax (ITBIS)</th>
                                <th class="text-right">Total</th>
                                <th>Payment Method</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['lines']" t-as="line">
                                <td><span t-esc="line['invoice_date']"/></td>
                                <td><span t-esc="line['name']"/></td>
                                <td><span t-esc="line['partner_name']"/></td>
                                <td><span t-esc="line['ncf']"/></td>
                                <td class="text-right">
                                    <span t-esc="line['amount_untaxed']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="line['discount']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="line['amount_tax']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="line['amount_total']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td><span t-esc="line['payment_method']"/></td>
                                <td><span t-esc="line['status_label']"/></td>
                            </tr>
                            <tr t-if="not data['lines']">
                                <td colspan="10" class="text-center text-muted">
                                    No invoices match the selected filters.
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:bold;border-top:2px solid #333;">
                                <td colspan="4" class="text-right">Totals</td>
                                <td class="text-right">
                                    <span t-esc="data['totals']['total_untaxed']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="data['totals']['total_discount']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="data['totals']['total_tax']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="data['totals']['total_invoiced']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td colspan="2"/>
                            </tr>
                        </tfoot>
                    </table>

                    <p class="text-muted mt16" style="font-size:10px;">
                        Generated on <span t-esc="data['generated_at']"/>
                    </p>

                </div>
            </t>
        </t>
    </template>

</odoo>
