<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="custom_billing_report.BillingHealthGauge">
        <div class="o_billing_health" t-att-class="statusClass">
            <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                <div class="o_billing_health_chart_wrapper flex-shrink-0">
                    <canvas t-ref="canvas"/>
                </div>
                <div class="flex-grow-1">
                    <div class="o_billing_health_badge mb-2">
                        <i class="fa o_billing_health_icon me-1"/>
                        <span class="fw-bold"><t t-esc="props.health.label"/></span>
                    </div>
                    <div class="o_billing_health_ratio mb-2">
                        <span class="display-6 fw-bold"><t t-esc="ratioPercent"/>%</span>
                        <span class="text-muted small ms-1">collected</span>
                    </div>
                    <ul class="list-unstyled small mb-0">
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Paid invoices</span>
                            <span>
                                <t t-esc="props.health.paid_count"/> / <t t-esc="props.health.total_count"/>
                            </span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Paid amount</span>
                            <span class="fw-bold"><t t-esc="formatMoney(props.health.paid_amount)"/></span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Pending amount</span>
                            <span class="fw-bold"><t t-esc="formatMoney(props.health.pending_amount)"/></span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </t>

</templates>
